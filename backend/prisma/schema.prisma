generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SITE_ENGINEER
  STOREKEEPER
  ACCOUNTANT
  WORKER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum WarehouseType {
  MAIN_STORE
  PROJECT_SITE
  TRANSIT
  TRUCK
  DAMAGED
  RETURNED
  SCRAP
}

enum ItemType {
  MATERIAL
  TOOL
  EQUIPMENT
  PPE
  FUEL
  CONSUMABLE
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  PARTIALLY_ORDERED
  ORDERED
  RECEIVED
  CLOSED
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum StockEntryStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum StockMovementType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  MATERIAL_TRANSFER
  MATERIAL_ISSUE
  RETURN_FROM_SITE
  DAMAGE
  LOSS
  ADJUSTMENT
  TOOL_CHECKOUT
  TOOL_RETURN
  EQUIPMENT_ASSIGNMENT
  FUEL_USAGE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ToolCheckoutStatus {
  CHECKED_OUT
  RETURNED
  LOST
  DAMAGED
}

enum EquipmentLogType {
  ASSIGNMENT
  USAGE
  DOWNTIME
  RETURN
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  EMERGENCY
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttachmentOwnerType {
  ITEM
  WAREHOUSE
  PROJECT
  SITE
  PURCHASE_REQUEST
  PURCHASE_ORDER
  STOCK_ENTRY
  STOCK_LEDGER
  TOOL_CHECKOUT
  EQUIPMENT_LOG
  FUEL_LOG
  MAINTENANCE_LOG
  DAMAGE_LOSS
  AUDIT_LOG
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  ISSUE
  TRANSFER
  RECEIVE
  ADJUST
  CHECKOUT
  RETURN
  DAMAGE
  LOSS
  LOGIN
  LOGOUT
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role
  status       UserStatus @default(ACTIVE)
  jobTitle     String?
  employeeCode String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  createdProjects         Project[]             @relation("ProjectCreatedBy")
  createdSites            Site[]                @relation("SiteCreatedBy")
  createdWarehouses       Warehouse[]           @relation("WarehouseCreatedBy")
  createdCategories       ItemCategory[]        @relation("ItemCategoryCreatedBy")
  createdItems            Item[]                @relation("ItemCreatedBy")
  createdSuppliers        Supplier[]            @relation("SupplierCreatedBy")
  purchaseRequests        PurchaseRequest[]     @relation("PurchaseRequestRequestedBy")
  createdPurchaseRequests PurchaseRequest[]     @relation("PurchaseRequestCreatedBy")
  purchaseOrders          PurchaseOrder[]       @relation("PurchaseOrderCreatedBy")
  stockEntries            StockEntry[]          @relation("StockEntryCreatedBy")
  requestedStockEntries   StockEntry[]          @relation("StockEntryRequestedBy")
  approvedStockEntries    StockEntry[]          @relation("StockEntryApprovedBy")
  receivedStockEntries    StockEntry[]          @relation("StockEntryReceivedBy")
  stockLedgers            StockLedger[]         @relation("StockLedgerCreatedBy")
  toolCheckouts           ToolCheckout[]        @relation("ToolCheckoutCheckedOutBy")
  toolResponsibleRecords  ToolCheckout[]        @relation("ToolCheckoutResponsibleWorker")
  toolReturnRecords       ToolCheckout[]        @relation("ToolCheckoutReturnedBy")
  equipmentLogs           EquipmentLog[]        @relation("EquipmentLogOperator")
  createdEquipmentLogs    EquipmentLog[]        @relation("EquipmentLogCreatedBy")
  fuelLogs                FuelLog[]             @relation("FuelLogOperator")
  createdFuelLogs         FuelLog[]             @relation("FuelLogCreatedBy")
  createdMaintenanceLogs  MaintenanceLog[]      @relation("MaintenanceLogCreatedBy")
  attachments             Attachment[]          @relation("AttachmentUploadedBy")
  approvalsRequested      Approval[]            @relation("ApprovalRequestedBy")
  approvalsDecided        Approval[]            @relation("ApprovalDecidedBy")
  auditLogs               AuditLog[]            @relation("AuditLogActor")
  settings                CompanySetting[]      @relation("CompanySettingUpdatedBy")

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique
  name        String
  description String?
  clientName  String?
  location    String?
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal       @default(0) @db.Decimal(18, 4)
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy        User?                 @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  phases           ProjectPhase[]
  sites            Site[]
  warehouses       Warehouse[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  stockEntries     StockEntry[]
  stockLedgers     StockLedger[]
  toolCheckouts    ToolCheckout[]
  equipmentLogs    EquipmentLog[]
  fuelLogs         FuelLog[]
  maintenanceLogs  MaintenanceLog[]

  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model ProjectPhase {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  name        String
  description String?
  sequence    Int       @default(0)
  budget      Decimal   @default(0) @db.Decimal(18, 4)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purchaseRequests PurchaseRequest[]
  stockEntryLines  StockEntryLine[]
  stockLedgers     StockLedger[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([createdAt])
}

model Site {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String?  @db.Uuid
  code        String   @unique
  name        String
  address     String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  qrCodeValue String?  @unique
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("SiteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  warehouses Warehouse[]

  @@index([projectId])
  @@index([createdById])
  @@index([createdAt])
}

model Warehouse {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique
  name        String
  type        WarehouseType
  projectId   String?       @db.Uuid
  siteId      String?       @db.Uuid
  address     String?
  isActive    Boolean       @default(true)
  qrCodeValue String?       @unique
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project               Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  site                  Site?              @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdBy             User?              @relation("WarehouseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sourceStockEntries    StockEntry[]       @relation("StockEntrySourceWarehouse")
  targetStockEntries    StockEntry[]       @relation("StockEntryTargetWarehouse")
  sourceStockLines      StockEntryLine[]   @relation("StockEntryLineSourceWarehouse")
  targetStockLines      StockEntryLine[]   @relation("StockEntryLineTargetWarehouse")
  stockLedgers          StockLedger[]
  stockBalances         StockBalance[]
  toolCheckouts         ToolCheckout[]     @relation("ToolCheckoutWarehouse")
  toolReturnWarehouses  ToolCheckout[]     @relation("ToolCheckoutReturnWarehouse")
  equipmentLogs         EquipmentLog[]
  fuelLogs              FuelLog[]

  @@index([type])
  @@index([projectId])
  @@index([siteId])
  @@index([createdById])
  @@index([createdAt])
}

model ItemCategory {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  parentId    String?  @db.Uuid
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent    ItemCategory?  @relation("ItemCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  ItemCategory[] @relation("ItemCategoryHierarchy")
  createdBy User?          @relation("ItemCategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     Item[]

  @@index([parentId])
  @@index([createdById])
  @@index([createdAt])
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  symbol    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                Item[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  stockEntryLines      StockEntryLine[]
  stockLedgers         StockLedger[]

  @@index([createdAt])
}

model Item {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  description     String?
  type            ItemType
  categoryId      String   @db.Uuid
  unitId          String   @db.Uuid
  defaultUnitCost Decimal  @default(0) @db.Decimal(18, 4)
  reorderLevel    Decimal  @default(0) @db.Decimal(18, 4)
  isTrackable     Boolean  @default(false)
  isActive        Boolean  @default(true)
  qrCodeValue     String?  @unique
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category             ItemCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit                 Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy            User?                @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  stockEntryLines      StockEntryLine[]
  stockLedgers         StockLedger[]
  stockBalances        StockBalance[]
  toolCheckouts        ToolCheckout[]
  equipmentLogs        EquipmentLog[]
  fuelLogs             FuelLog[]            @relation("FuelLogFuelItem")
  equipmentFuelLogs    FuelLog[]            @relation("FuelLogEquipmentItem")
  maintenanceLogs      MaintenanceLog[]

  @@index([type])
  @@index([categoryId])
  @@index([unitId])
  @@index([createdById])
  @@index([createdAt])
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  taxNumber     String?
  isActive      Boolean  @default(true)
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy        User?             @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]

  @@index([createdById])
  @@index([createdAt])
}

model PurchaseRequest {
  id             String        @id @default(uuid()) @db.Uuid
  requestNumber  String        @unique
  status         RequestStatus @default(DRAFT)
  projectId      String?       @db.Uuid
  projectPhaseId String?       @db.Uuid
  supplierId     String?       @db.Uuid
  neededByDate   DateTime?
  justification  String?
  requestedById  String        @db.Uuid
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project        Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectPhase   ProjectPhase?         @relation(fields: [projectPhaseId], references: [id], onDelete: SetNull)
  supplier       Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  requestedBy    User                  @relation("PurchaseRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  createdBy      User?                 @relation("PurchaseRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]
  approvals      Approval[]

  @@index([status])
  @@index([projectId])
  @@index([projectPhaseId])
  @@index([supplierId])
  @@index([requestedById])
  @@index([createdById])
  @@index([createdAt])
}

model PurchaseRequestItem {
  id                String  @id @default(uuid()) @db.Uuid
  purchaseRequestId String  @db.Uuid
  itemId            String  @db.Uuid
  unitId            String  @db.Uuid
  quantity          Decimal @db.Decimal(18, 4)
  estimatedUnitCost Decimal @default(0) @db.Decimal(18, 4)
  estimatedTotal    Decimal @default(0) @db.Decimal(18, 4)
  notes             String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  item            Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  unit            Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([purchaseRequestId])
  @@index([itemId])
  @@index([unitId])
}

model PurchaseOrder {
  id                String              @id @default(uuid()) @db.Uuid
  orderNumber       String              @unique
  status            PurchaseOrderStatus @default(DRAFT)
  supplierId        String              @db.Uuid
  projectId         String?             @db.Uuid
  purchaseRequestId String?             @db.Uuid
  orderedAt         DateTime?
  expectedAt        DateTime?
  totalAmount       Decimal             @default(0) @db.Decimal(18, 4)
  createdById       String?             @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items           PurchaseOrderItem[]
  stockEntries    StockEntry[]

  @@index([status])
  @@index([supplierId])
  @@index([projectId])
  @@index([purchaseRequestId])
  @@index([createdById])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @db.Uuid
  itemId          String  @db.Uuid
  unitId          String  @db.Uuid
  quantity        Decimal @db.Decimal(18, 4)
  receivedQty     Decimal @default(0) @db.Decimal(18, 4)
  unitCost        Decimal @default(0) @db.Decimal(18, 4)
  totalCost       Decimal @default(0) @db.Decimal(18, 4)
  notes           String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  unit          Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([itemId])
  @@index([unitId])
}

model StockEntry {
  id                String            @id @default(uuid()) @db.Uuid
  entryNumber       String            @unique
  movementType      StockMovementType
  status            StockEntryStatus  @default(DRAFT)
  sourceWarehouseId String?           @db.Uuid
  targetWarehouseId String?           @db.Uuid
  projectId         String?           @db.Uuid
  purchaseOrderId   String?           @db.Uuid
  referenceNumber   String?
  reason            String?
  postedAt          DateTime?
  requestedById     String?           @db.Uuid
  approvedById      String?           @db.Uuid
  receivedById      String?           @db.Uuid
  createdById       String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  sourceWarehouse Warehouse?       @relation("StockEntrySourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  targetWarehouse Warehouse?       @relation("StockEntryTargetWarehouse", fields: [targetWarehouseId], references: [id], onDelete: Restrict)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  requestedBy     User?            @relation("StockEntryRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy      User?            @relation("StockEntryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  receivedBy      User?            @relation("StockEntryReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("StockEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines           StockEntryLine[]
  ledgers         StockLedger[]

  @@index([movementType])
  @@index([status])
  @@index([sourceWarehouseId])
  @@index([targetWarehouseId])
  @@index([projectId])
  @@index([purchaseOrderId])
  @@index([createdById])
  @@index([createdAt])
}

model StockEntryLine {
  id                String  @id @default(uuid()) @db.Uuid
  stockEntryId      String  @db.Uuid
  itemId            String  @db.Uuid
  unitId            String  @db.Uuid
  sourceWarehouseId String? @db.Uuid
  targetWarehouseId String? @db.Uuid
  projectPhaseId    String? @db.Uuid
  quantity          Decimal @db.Decimal(18, 4)
  unitCost          Decimal @default(0) @db.Decimal(18, 4)
  totalCost         Decimal @default(0) @db.Decimal(18, 4)
  reason            String?
  notes             String?

  stockEntry      StockEntry    @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  item            Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  unit            Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  sourceWarehouse Warehouse?    @relation("StockEntryLineSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  targetWarehouse Warehouse?    @relation("StockEntryLineTargetWarehouse", fields: [targetWarehouseId], references: [id], onDelete: Restrict)
  projectPhase    ProjectPhase? @relation(fields: [projectPhaseId], references: [id], onDelete: SetNull)
  ledgers         StockLedger[]

  @@index([stockEntryId])
  @@index([itemId])
  @@index([unitId])
  @@index([sourceWarehouseId])
  @@index([targetWarehouseId])
  @@index([projectPhaseId])
}

model StockLedger {
  id             String            @id @default(uuid()) @db.Uuid
  stockEntryId   String            @db.Uuid
  entryLineId    String?           @db.Uuid
  movementType   StockMovementType
  itemId         String            @db.Uuid
  warehouseId    String            @db.Uuid
  projectId      String?           @db.Uuid
  projectPhaseId String?           @db.Uuid
  unitId         String            @db.Uuid
  quantityIn     Decimal           @default(0) @db.Decimal(18, 4)
  quantityOut    Decimal           @default(0) @db.Decimal(18, 4)
  balanceAfter   Decimal?          @db.Decimal(18, 4)
  unitCost       Decimal           @default(0) @db.Decimal(18, 4)
  totalCost      Decimal           @default(0) @db.Decimal(18, 4)
  reference      String?
  remarks        String?
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now())

  stockEntry   StockEntry      @relation(fields: [stockEntryId], references: [id], onDelete: Restrict)
  entryLine    StockEntryLine? @relation(fields: [entryLineId], references: [id], onDelete: SetNull)
  item         Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectPhase ProjectPhase?   @relation(fields: [projectPhaseId], references: [id], onDelete: SetNull)
  unit         Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy    User?           @relation("StockLedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([stockEntryId])
  @@index([entryLineId])
  @@index([movementType])
  @@index([itemId])
  @@index([warehouseId])
  @@index([projectId])
  @@index([projectPhaseId])
  @@index([createdById])
  @@index([createdAt])
}

model StockBalance {
  id          String   @id @default(uuid()) @db.Uuid
  itemId      String   @db.Uuid
  warehouseId String   @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  averageCost Decimal  @default(0) @db.Decimal(18, 4)
  valuation   Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([itemId, warehouseId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([createdAt])
}

model ToolCheckout {
  id                    String             @id @default(uuid()) @db.Uuid
  checkoutNumber        String             @unique
  toolItemId            String             @db.Uuid
  warehouseId           String             @db.Uuid
  projectId             String?            @db.Uuid
  responsibleWorkerId   String             @db.Uuid
  checkedOutById        String             @db.Uuid
  returnedById          String?            @db.Uuid
  returnWarehouseId     String?            @db.Uuid
  status                ToolCheckoutStatus @default(CHECKED_OUT)
  quantity              Decimal            @default(1) @db.Decimal(18, 4)
  checkedOutAt          DateTime           @default(now())
  expectedReturnAt      DateTime?
  returnedAt            DateTime?
  checkoutCondition     String?
  returnCondition       String?
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  toolItem          Item       @relation(fields: [toolItemId], references: [id], onDelete: Restrict)
  warehouse         Warehouse  @relation("ToolCheckoutWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  project           Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  responsibleWorker User       @relation("ToolCheckoutResponsibleWorker", fields: [responsibleWorkerId], references: [id], onDelete: Restrict)
  checkedOutBy      User       @relation("ToolCheckoutCheckedOutBy", fields: [checkedOutById], references: [id], onDelete: Restrict)
  returnedBy        User?      @relation("ToolCheckoutReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  returnWarehouse   Warehouse? @relation("ToolCheckoutReturnWarehouse", fields: [returnWarehouseId], references: [id], onDelete: Restrict)

  @@index([toolItemId])
  @@index([warehouseId])
  @@index([projectId])
  @@index([responsibleWorkerId])
  @@index([checkedOutById])
  @@index([status])
  @@index([createdAt])
}

model EquipmentLog {
  id               String           @id @default(uuid()) @db.Uuid
  equipmentItemId  String           @db.Uuid
  type             EquipmentLogType
  projectId        String?          @db.Uuid
  warehouseId      String?          @db.Uuid
  operatorId       String?          @db.Uuid
  usageHours       Decimal          @default(0) @db.Decimal(18, 4)
  odometerReading  Decimal?         @db.Decimal(18, 4)
  startedAt        DateTime?
  endedAt          DateTime?
  notes            String?
  createdById      String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  equipmentItem   Item             @relation(fields: [equipmentItemId], references: [id], onDelete: Restrict)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  operator        User?            @relation("EquipmentLogOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("EquipmentLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]

  @@index([equipmentItemId])
  @@index([type])
  @@index([projectId])
  @@index([warehouseId])
  @@index([operatorId])
  @@index([createdById])
  @@index([createdAt])
}

model FuelLog {
  id              String   @id @default(uuid()) @db.Uuid
  equipmentItemId String?  @db.Uuid
  fuelItemId      String   @db.Uuid
  equipmentLogId  String?  @db.Uuid
  warehouseId     String?  @db.Uuid
  projectId       String?  @db.Uuid
  operatorId      String?  @db.Uuid
  quantity        Decimal  @db.Decimal(18, 4)
  unitCost        Decimal  @default(0) @db.Decimal(18, 4)
  totalCost       Decimal  @default(0) @db.Decimal(18, 4)
  loggedAt        DateTime @default(now())
  notes           String?
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  equipmentItem Item?         @relation("FuelLogEquipmentItem", fields: [equipmentItemId], references: [id], onDelete: SetNull)
  fuelItem      Item          @relation("FuelLogFuelItem", fields: [fuelItemId], references: [id], onDelete: Restrict)
  equipmentLog  EquipmentLog? @relation(fields: [equipmentLogId], references: [id], onDelete: SetNull)
  warehouse     Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  operator      User?         @relation("FuelLogOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("FuelLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([equipmentItemId])
  @@index([fuelItemId])
  @@index([equipmentLogId])
  @@index([warehouseId])
  @@index([projectId])
  @@index([operatorId])
  @@index([createdById])
  @@index([createdAt])
}

model MaintenanceLog {
  id              String            @id @default(uuid()) @db.Uuid
  equipmentItemId String            @db.Uuid
  equipmentLogId  String?           @db.Uuid
  projectId       String?           @db.Uuid
  type            MaintenanceType
  status          MaintenanceStatus @default(SCHEDULED)
  scheduledAt     DateTime?
  completedAt     DateTime?
  cost            Decimal           @default(0) @db.Decimal(18, 4)
  description     String?
  createdById     String?           @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  equipmentItem Item          @relation(fields: [equipmentItemId], references: [id], onDelete: Restrict)
  equipmentLog  EquipmentLog? @relation(fields: [equipmentLogId], references: [id], onDelete: SetNull)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("MaintenanceLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([equipmentItemId])
  @@index([equipmentLogId])
  @@index([projectId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model Attachment {
  id           String              @id @default(uuid()) @db.Uuid
  ownerType    AttachmentOwnerType
  ownerId      String              @db.Uuid
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  storagePath  String
  checksum     String?
  uploadedById String?             @db.Uuid
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  uploadedBy User? @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ownerType, ownerId])
  @@index([uploadedById])
  @@index([createdAt])
}

model Approval {
  id                String         @id @default(uuid()) @db.Uuid
  purchaseRequestId String?        @db.Uuid
  status            ApprovalStatus @default(PENDING)
  stepName          String
  requestedById     String?        @db.Uuid
  decidedById       String?        @db.Uuid
  decisionNotes     String?
  requestedAt       DateTime       @default(now())
  decidedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  requestedBy     User?            @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy       User?            @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([purchaseRequestId])
  @@index([status])
  @@index([requestedById])
  @@index([decidedById])
  @@index([createdAt])
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  action     AuditAction
  entityType String
  entityId   String?     @db.Uuid
  actorId    String?     @db.Uuid
  summary    String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model CompanySetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("CompanySettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@index([createdAt])
}
